# opsconsoled -- the admin panel: orders, pricing, vendors, wallets, sweeps.
# scripts/dev.sh setup copies this file to .env.local and fills in every
# {{...}} value.

OC_LISTEN_ADDR='127.0.0.1:{{PORT_OPSCONSOLE}}'
OC_SESSION_SECRET='{{SECRET_OC_SESSION}}'
# Logins: username:bcrypt-hash:Display Name, comma-separated. Make a hash with
#   printf '%s' 'the password' | go run ./cmd/hashpassword
OC_OPERATORS='admin:{{OC_ADMIN_HASH}}:Local admin'
OC_AUDIT_LOG_PATH='{{OC_AUDIT_LOG_PATH}}'

OC_LEDGER_BASE_URL='http://127.0.0.1:{{PORT_LEDGER}}'
OC_LEDGER_TOKEN='{{TOKEN_LEDGER_OPSCONSOLE}}'
OC_WATCHER_BASE_URL='http://127.0.0.1:{{PORT_WATCHER}}'
OC_WATCHER_TOKEN='{{TOKEN_WATCHER_OPSCONSOLE}}'
OC_TRONWATCHER_BASE_URL='http://127.0.0.1:{{PORT_TRONWATCHER}}'
OC_TRONWATCHER_TOKEN='{{TOKEN_TRONWATCHER_OPSCONSOLE}}'
OC_RELAYD_BASE_URL='http://127.0.0.1:{{PORT_RELAYD}}'
OC_RELAYD_TOKEN='{{TOKEN_RELAYD_OPSCONSOLE}}'
OC_SCREENING_BASE_URL='http://127.0.0.1:{{PORT_SCREENING}}'
OC_SCREENING_TOKEN='{{TOKEN_SCREENING_OPSCONSOLE}}'
OC_S1_BASE_URL='http://127.0.0.1:{{PORT_S1}}'
OC_S1_C5_TOKEN='{{TOKEN_S1_OPSCONSOLE}}'

# The dispatcher and energy broker belong to the earlier "Model D" design
# and are not part of the running product, so nothing listens here; the
# console shows them as down.
OC_BROKER_BASE_URL='http://127.0.0.1:{{PORT_BROKER}}'
OC_BROKER_TOKEN='not-running'
OC_DISPATCHER_BASE_URL='http://127.0.0.1:{{PORT_DISPATCHER}}'
OC_DISPATCHER_TOKEN='not-running'
