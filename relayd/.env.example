# relayd -- the core service: quotes, orders, and moving each order's money
# (gas and energy top-ups, forwarding to the conversion vendor, payout
# checks, refunds, profit sweeps). scripts/dev.sh setup copies this file to
# .env.local and fills in every {{...}} value.

RELAYD_LISTEN_ADDR='127.0.0.1:{{PORT_RELAYD}}'
RELAYD_DATABASE_URL='{{DB_RELAYD}}'
RELAYD_LEDGER_BASE_URL='http://127.0.0.1:{{PORT_LEDGER}}'
RELAYD_LEDGER_TOKEN='{{TOKEN_LEDGER_RELAYD}}'
RELAYD_DEPOSITWATCHER_BASE_URL='http://127.0.0.1:{{PORT_WATCHER}}'
RELAYD_DEPOSITWATCHER_TOKEN='{{TOKEN_WATCHER_RELAYD}}'
RELAYD_TRONWATCHER_BASE_URL='http://127.0.0.1:{{PORT_TRONWATCHER}}'
RELAYD_TRONWATCHER_TOKEN='{{TOKEN_TRONWATCHER_RELAYD}}'
RELAYD_SIGNING_BASE_URL='http://127.0.0.1:{{PORT_S1}}'
RELAYD_SIGNING_TOKEN='{{TOKEN_S1_RELAYD}}'

# The treasury wallet is an S1 slot; scripts/dev.sh setup registers slot 1.
# More treasuries: RELAYD_TREASURY_SLOT_IDS='3,4'.
RELAYD_SLOT_ID='1'

# Chain access. Public endpoints work; a free TronGrid key avoids rate limits.
RELAYD_BSC_RPC_URL='https://bsc-dataseed.bnbchain.org'
RELAYD_TRON_GRPC_ADDR='grpc.trongrid.io:50051'
RELAYD_TRON_API_BASE_URL='https://api.trongrid.io'
RELAYD_TRONGRID_API_KEY=''
RELAYD_ENERGY_PER_TRANSFER_UNITS='65000'

# Conversion vendor. Locally: a simulated one (quotes and orders only;
# nothing reaches a real exchange). Production: UPSTREAM_PROVIDER='fixedfloat'
# with FIXEDFLOAT_API_KEY, FIXEDFLOAT_API_SECRET,
# FIXEDFLOAT_CCY_USDT_TRC20='USDTTRC' and FIXEDFLOAT_CCY_USDT_BEP20='USDTBSC',
# or UPSTREAM_PROVIDER='router' with UPSTREAM_VENDORS='fixedfloat,changenow'.
UPSTREAM_PROVIDER='demo'
UPSTREAM_ALLOW_DEMO='true'

# TRON energy rental (needed only to move USDT on TRON):
# RELAYD_CATFEE_API_KEY='' and RELAYD_CATFEE_API_SECRET=''

# Admin API, used by the ops console, screening, and you: token:name pairs,
# each token at least 24 characters.
RELAYD_ADMIN_TOKENS='{{TOKEN_RELAYD_ADMIN}}:you,{{TOKEN_RELAYD_OPSCONSOLE}}:opsconsole,{{TOKEN_RELAYD_SCREENING}}:screening'
