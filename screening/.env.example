# screend -- checks each order before any money moves (AML screening).
# scripts/dev.sh setup copies this file to .env.local and fills in every
# {{...}} value.

SCREENING_LISTEN_ADDR='127.0.0.1:{{PORT_SCREENING}}'
SCREENING_DATABASE_URL='{{DB_SCREENING}}'
SCREENING_API_TOKENS='{{TOKEN_SCREENING_OPSCONSOLE}}:opsconsole'
SCREENING_LEDGER_BASE_URL='http://127.0.0.1:{{PORT_LEDGER}}'
SCREENING_LEDGER_TOKEN='{{TOKEN_LEDGER_SCREENING}}'
# Lets an operator's rejection of a held order refund it through relayd.
SCREENING_RELAYD_BASE_URL='http://127.0.0.1:{{PORT_RELAYD}}'
SCREENING_RELAYD_TOKEN='{{TOKEN_RELAYD_SCREENING}}'

# NOT a real check: approves every order. Fine locally; a public launch
# needs a real screening vendor, which is not built yet.
SCREENING_PROVIDER='always_clean'
SCREENING_ALLOW_ALWAYS_CLEAN='true'
