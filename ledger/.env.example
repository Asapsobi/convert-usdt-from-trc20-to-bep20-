# ledgerd -- the double-entry ledger every money movement is recorded in.
# scripts/dev.sh setup copies this file to .env.local and fills in every
# {{...}} value. Values are single-quoted so a shell reads them literally.

LEDGER_LISTEN_ADDR='127.0.0.1:{{PORT_LEDGER}}'
LEDGER_DATABASE_URL='{{DB_LEDGER}}'
# Who may call the ledger: token:caller pairs, comma-separated.
LEDGER_API_TOKENS='{{TOKEN_LEDGER_RELAYD}}:relayd,{{TOKEN_LEDGER_WATCHER}}:depositwatcher,{{TOKEN_LEDGER_TRONWATCHER}}:tronwatcher,{{TOKEN_LEDGER_SCREENING}}:screening,{{TOKEN_LEDGER_OPSCONSOLE}}:opsconsole'
