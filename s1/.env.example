# s1d -- the signing service. It holds (or reaches) every private key and
# signs transactions for relayd. scripts/dev.sh setup copies this file to
# .env.local and fills in every {{...}} value.

S1_LISTEN_ADDR='127.0.0.1:{{PORT_S1}}'
S1_DATABASE_URL='{{DB_S1}}'
# Callers, as token:caller pairs: signing (relayd, ops console) and approvals.
S1_C5_API_TOKENS='{{TOKEN_S1_RELAYD}}:relayd,{{TOKEN_S1_OPSCONSOLE}}:opsconsole'
S1_APPROVER_API_TOKENS='{{TOKEN_S1_APPROVER}}:approver'
# Creating deposit wallets (the watchers ask for them). Only the Privy
# backend creates wallets; locally the watchers derive addresses from the
# XPUBs below instead.
S1_PROVISIONING_API_TOKENS='{{TOKEN_S1_WATCHER}}:depositwatcher,{{TOKEN_S1_TRONWATCHER}}:tronwatcher'
# A signature worth more than this many USD waits for a person to approve it.
S1_APPROVAL_THRESHOLD_USD='1000'

# Keys. LOCAL ONLY: generated by scripts/dev.sh setup (s1/cmd/dev-keys) and
# stored in this plain file, so never send real money to a local setup.
# Production keeps every key in Privy instead: S1_KMS_CLIENT='privy',
# PRIVY_APP_ID, PRIVY_APP_SECRET, and none of the lines below.
S1_KMS_CLIENT='fake'
S1_KMS_FAKE_SEED='{{S1_KMS_FAKE_SEED}}'
S1_BSC_DEPOSIT_XPRV='{{S1_BSC_DEPOSIT_XPRV}}'
S1_BSC_DEPOSIT_XPUB='{{S1_BSC_DEPOSIT_XPUB}}'
S1_TRON_DEPOSIT_XPRV='{{S1_TRON_DEPOSIT_XPRV}}'
S1_TRON_DEPOSIT_XPUB='{{S1_TRON_DEPOSIT_XPUB}}'
