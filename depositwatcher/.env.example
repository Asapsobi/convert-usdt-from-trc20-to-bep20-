# watcherd -- watches BNB Smart Chain for USDT (BEP-20) deposits and owns
# the BSC deposit-wallet pool. scripts/dev.sh setup copies this file to
# .env.local and fills in every {{...}} value.

WATCHER_LISTEN_ADDR='127.0.0.1:{{PORT_WATCHER}}'
WATCHER_DATABASE_URL='{{DB_WATCHER}}'
WATCHER_API_TOKENS='{{TOKEN_WATCHER_RELAYD}}:relayd,{{TOKEN_WATCHER_OPSCONSOLE}}:opsconsole'
WATCHER_LEDGER_BASE_URL='http://127.0.0.1:{{PORT_LEDGER}}'
WATCHER_LEDGER_TOKEN='{{TOKEN_LEDGER_WATCHER}}'

# Where deposit addresses come from. Locally: derived from this public key,
# whose private half is S1_BSC_DEPOSIT_XPRV in s1/.env.local. Production:
# remove WATCHER_XPUB and set WATCHER_S1_BASE_URL and
# WATCHER_S1_PROVISIONING_TOKEN, so S1 creates each wallet in Privy.
WATCHER_XPUB='{{S1_BSC_DEPOSIT_XPUB}}'

# BNB Smart Chain node(s), name=url, comma-separated. Two or more is safer;
# a single one needs WATCHER_ALLOW_SINGLE_PROVIDER. Leave empty to run
# without watching the chain (orders can be created, deposits are never seen).
WATCHER_RPC_PROVIDERS='publicnode=https://bsc-rpc.publicnode.com'
WATCHER_ALLOW_SINGLE_PROVIDER='true'
