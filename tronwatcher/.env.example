# tronwatcherd -- watches TRON for USDT (TRC-20) deposits and owns the TRON
# deposit-wallet pool. scripts/dev.sh setup copies this file to .env.local
# and fills in every {{...}} value.

TRONWATCHER_LISTEN_ADDR='127.0.0.1:{{PORT_TRONWATCHER}}'
TRONWATCHER_DATABASE_URL='{{DB_TRONWATCHER}}'
TRONWATCHER_API_TOKENS='{{TOKEN_TRONWATCHER_RELAYD}}:relayd,{{TOKEN_TRONWATCHER_OPSCONSOLE}}:opsconsole'
TRONWATCHER_LEDGER_BASE_URL='http://127.0.0.1:{{PORT_LEDGER}}'
TRONWATCHER_LEDGER_TOKEN='{{TOKEN_LEDGER_TRONWATCHER}}'

# Where deposit addresses come from. Locally: derived from this public key,
# whose private half is S1_TRON_DEPOSIT_XPRV in s1/.env.local. Production:
# remove TRONWATCHER_XPUB and set TRONWATCHER_S1_BASE_URL and
# TRONWATCHER_S1_PROVISIONING_TOKEN, so S1 creates each wallet in Privy.
TRONWATCHER_XPUB='{{S1_TRON_DEPOSIT_XPUB}}'

# TronGrid, name=url, at least two entries (the same URL twice is fine).
# Leave empty to run without watching the chain.
TRONWATCHER_PROVIDERS='trongrid-a=https://api.trongrid.io,trongrid-b=https://api.trongrid.io'
# Optional, recommended: a free API key from trongrid.io. Without one,
# TronGrid often answers "too many requests".
TRONWATCHER_API_KEY=''
TRONWATCHER_POLL_INTERVAL='30s'
