# Copy this file to .env and fill in every value below with the real
# thing before running `docker compose up` against docker-compose.yml.
# See docs/03-build/mvp-proof-run-plan.md's own "OPERATOR-SUPPLIED
# PREREQUISITES" for what each of these is and why no code default
# exists for it -- every value here is either real money/credentials or
# a secret that would be unsafe to ship a working default for.

# ---- C2: deposit watcher (BSC) ----
# Real BIP32 xpub for HD deposit-address derivation. A placeholder here
# would derive real, unspendable-by-anyone-who-matters addresses.
WATCHER_XPUB=

# Comma-separated real BSC RPC endpoint(s).
WATCHER_RPC_PROVIDERS=

# ---- C4: energy broker (TRON energy vendors) ----
# Tronsell is the only vendor with no code default (Netts/Catfee below
# are optional -- leave blank to disable that vendor).
BROKER_TRONSELL_BASE_URL=
BROKER_TRONSELL_API_KEY=
BROKER_NETTS_API_KEY=
BROKER_NETTS_REAL_IP=
BROKER_CATFEE_API_KEY=
BROKER_CATFEE_API_SECRET=

# The real, funded TRON slot address(es) energy gets delegated to.
BROKER_PAYOUT_SLOT_ADDRESSES=

# Real TronGrid API key (also used by the dispatcher's own TRON API calls).
BROKER_TRONGRID_API_KEY=

# ---- Model F: tronwatcher (C2') + relayd (zero-float relay) ----
# Real BIP32 xpub for HD TRC20 deposit-address derivation -- a SEPARATE
# xpub from WATCHER_XPUB above (TRON/BSC addresses are derived
# independently).
TRONWATCHER_XPUB=

# name=url pairs, comma-separated -- real TronGrid endpoint(s), e.g.
#   trongrid=https://api.trongrid.io
TRONWATCHER_PROVIDERS=

# Real BSC RPC endpoint -- relayd's own BEP20_TO_TRC20 forward leg
# broadcasts a real transaction through this.
RELAYD_BSC_RPC_URL=

# The dedicated S1 slot relayd signs both relay directions' forward legs
# with -- deliberately separate from any Model D payout slot. A real slot
# number from a real S1 deployment (see s1/internal/slots's own
# provisioning).
RELAYD_SLOT_ID=

# ---- ops console (internal operator dashboard) ----
# Signs the operator session cookie. Generate with e.g.
#   openssl rand -hex 32
OC_SESSION_SECRET=

# "username:bcrypt_hash:display_name,..." -- one entry per operator.
# Generate a bcrypt hash with e.g.
#   go run golang.org/x/crypto/bcrypt/cmd/... (or any bcrypt CLI/library)
# Example shape only -- this hash is NOT valid, replace it:
OC_OPERATORS=alice:$2a$10$REPLACEWITHREALBCRYPTHASH:Alice Operator

# ---- Optional overrides (safe defaults exist for all of these) ----
# LEDGER_API_TOKENS=ledgertoken:proofrun
# WATCHER_API_TOKENS=watchertoken:proofrun
# SCREENING_API_TOKENS=screentoken:proofrun
# BROKER_API_TOKENS=brokertoken:proofrun
# DISPATCHER_API_TOKENS=dispatchertoken:proofrun
# S1_C5_API_TOKENS=s1c5token:dispatcher
# S1_APPROVER_API_TOKENS=s1approvertoken:operator
# BROKER_ROUTING_WEIGHTS=tronsell:100
# BROKER_PRICE_CEILING_SUN=100
# BROKER_TRONGRID_BASE_URL=https://api.trongrid.io
# DISPATCHER_SLOT_BALANCE_CEILING=50000.000000
# DISPATCHER_SLOT_TX_COUNT_CEILING=5000
# DISPATCHER_ENERGY_PER_TRANSFER_UNITS=65000
# DISPATCHER_ORCHESTRATE_INTERVAL=5s
# DISPATCHER_TRON_GRPC_ADDR=grpc.trongrid.io:50051
# DISPATCHER_TRON_API_BASE_URL=https://api.trongrid.io
# WATCHER_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
# S1_APPROVAL_THRESHOLD_USD=1000000
# PROOFRUN_FEE_BASIS_POINTS=25
# PROOFRUN_NETWORK_FEE_UNITS=1.800000
# PROOFRUN_QUOTE_VALIDITY=24h
# TRONWATCHER_API_TOKENS=tronwatchertoken:relayd
# TRONWATCHER_API_KEY=
# TRONWATCHER_FINALITY_BASE_URL=https://api.trongrid.io
# TRONWATCHER_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# RELAYD_ENERGY_PER_TRANSFER_UNITS=65000
# RELAYD_TRON_GRPC_ADDR=grpc.trongrid.io:50051
# RELAYD_TRON_API_BASE_URL=https://api.trongrid.io
# RELAYD_FEE_BASIS_POINTS=25
# UPSTREAM_PROVIDER=placeholder
# UPSTREAM_ALLOW_PLACEHOLDER=true
